MOCHI_TOKEN=replace-with-a-private-device-key-of-at-least-32-characters
MOCHI_DATA_DIR=/data
MOCHI_MEMORY_PATH=/shared/memory.sqlite3
WHISPER_MODEL=base
# Leave at 0 for base. The verified pinned small model uses 1600 (see services/asr).
WHISPER_ENCODER_FRAMES=0
HERMES_URL=http://192.168.8.245:30432
HERMES_PROFILE=mochi
HERMES_API_KEY=replace-with-the-private-mochi-profile-key
MOCHI_AGENT_ENABLED=1
MOCHI_HERMES_WARMUP=1
MOCHI_VOICE_PROVIDER=native
MOCHI_NATIVE_VOICE_URL=http://192.168.8.245:8775
MOCHI_NATIVE_VOICE_TOKEN=replace-with-the-private-voice-key
MOCHI_NATIVE_VOICE_PROFILE=replace-with-the-sha256-of-the-approved-private-profile
MOCHI_NATIVE_VOICE_SOURCE=nas
# Set MOCHI_VOICE_PROVIDER=elevenlabs only after cloning and verifying voice 03.
# Keep this key on the NAS; never provision it to the ESP32.
ELEVENLABS_API_KEY=
# Prefer a read-only secret file in production; this overrides the inline key.
ELEVENLABS_API_KEY_FILE=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# SHA256 of the source-sample manifest produced by ElevenLabs-Mochi.py clone.
ELEVENLABS_VOICE_REVISION=
MOCHI_FAST_ENABLED=1
MOCHI_FAST_URL=http://192.168.8.245:8776
MOCHI_FAST_KEY=replace-with-the-private-local-model-key
MOCHI_PROFILE_DIR=/profile
MOCHI_MEMORY_REVIEW_ENABLED=1
# Use the existing tools model for idle extraction, preserving fast-model KV.
MOCHI_MEMORY_REVIEW_URL=http://192.168.8.245:8769
MOCHI_NAVIGATION_ENABLED=1
# Optional own instances. Defaults are rate-limited public OSM services.
MOCHI_NAVIGATION_PHOTON=https://photon.komoot.io/api/
MOCHI_NAVIGATION_ROUTER=https://routing.openstreetmap.de
MOCHI_NAVIGATION_TILES=https://tile.openstreetmap.org
MOCHI_TIMEZONE=Europe/Madrid
MOCHI_AUDIO_CACHE_MB=256
MOCHI_WAKE_WORKER_ENABLED=1
