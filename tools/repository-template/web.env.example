# Public browser configuration from your own Supabase project.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-your-own-publishable-key
VITE_SUPABASE_PROJECT_ID=replace-with-your-own-project-id
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-your-own-publishable-key

# Server-only. Never use a private value in VITE_* variables.
PELUQO_DATABASE_URL=postgresql://YOUR_ROLE:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE
PELUQO_WEB_ORIGIN=http://localhost:3000
PELUQO_AI_URL=http://localhost:54321
PELUQO_INTEGRATION_KEY=replace-with-a-new-private-integration-key
PELUQO_PAIRING_KEY=replace-with-a-new-private-pairing-key
PELUQO_INFERENCE_QUEUE=0
# Required only by optional legacy server integrations:
SUPABASE_SERVICE_ROLE_KEY=
