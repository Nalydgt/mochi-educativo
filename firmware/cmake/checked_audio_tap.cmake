# Expose the BSP's existing TX handle so its real DMA output can drive the face.
# No managed source, pin assignment, I2S format or channel allocation is changed.
idf_component_get_property(tap_bsp_dir waveshare__esp32_s3_touch_amoled_1_75 COMPONENT_DIR)
idf_component_get_property(tap_bsp_target waveshare__esp32_s3_touch_amoled_1_75 COMPONENT_LIB)
file(READ "${tap_bsp_dir}/esp32_s3_touch_amoled_1_75.c" tap_bsp_source)
string(FIND "${tap_bsp_source}" "static i2s_chan_handle_t i2s_tx_chan = NULL;" tap_bsp_position)
if(tap_bsp_position EQUAL -1)
    message(FATAL_ERROR "Waveshare audio handle changed; review checked_audio_tap.cmake")
endif()
string(APPEND tap_bsp_source "\n/* Mochi: expose the existing TX channel for output monitoring. */\ni2s_chan_handle_t mochi_board_audio_tx_channel(void) { return i2s_tx_chan; }\n")
set(tap_bsp_checked "${CMAKE_BINARY_DIR}/mochi_bsp_audio_tap.c")
file(WRITE "${tap_bsp_checked}" "${tap_bsp_source}")
get_target_property(tap_bsp_sources ${tap_bsp_target} SOURCES)
set(tap_bsp_found FALSE)
foreach(tap_bsp_file IN LISTS tap_bsp_sources)
    get_filename_component(tap_bsp_name "${tap_bsp_file}" NAME)
    if(tap_bsp_name STREQUAL "esp32_s3_touch_amoled_1_75.c")
        list(REMOVE_ITEM tap_bsp_sources "${tap_bsp_file}")
        set(tap_bsp_found TRUE)
    endif()
endforeach()
if(NOT tap_bsp_found)
    message(FATAL_ERROR "Cannot locate Waveshare BSP audio source")
endif()
set_property(TARGET ${tap_bsp_target} PROPERTY SOURCES "${tap_bsp_sources}")
target_sources(${tap_bsp_target} PRIVATE "${tap_bsp_checked}")
